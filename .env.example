# ==============================================================================
# SMART AI FACE RECOGNITION — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your custom values before running.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED FOR RENDER] Port on which the backend server listens (default: 8000)
PORT=8000

# [OPTIONAL] Public URL of your deployed backend server (e.g. https://your-backend.onrender.com)
PUBLIC_BASE_URL=http://localhost:8000

# [OPTIONAL] Allowed CORS origins for frontend access (comma-separated or '*')
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# 2. MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED] Connection string to MongoDB instance
# Local: mongodb://localhost:27017
# Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://Princesp02:Princesp02@cluster0.tykleyq.mongodb.net/face_engine?appName=Cluster0

# [REQUIRED] Database name
DB_NAME=face_engine

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# [RECOMMENDED FOR PROD] Secret key used for signing JWT auth tokens
JWT_SECRET=dev-jwt-secret-key-change-in-production-12345

# [OPTIONAL] Default admin user email created on server startup
ADMIN_EMAIL=admin@example.com

# [OPTIONAL] Default admin password
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 4. FACE ENGINE & FILE STORAGE
# ------------------------------------------------------------------------------
# [OPTIONAL] Cosine similarity threshold for face recognition (0.0 to 1.0, default: 0.42)
FACE_MATCH_THRESHOLD=0.42

# [OPTIONAL] Directory path where face photos, camera snapshots, and unknown captures are stored
UPLOAD_ROOT=./backend/uploads

# [OPTIONAL] Alert cooldown in seconds for unknown face notifications per camera (default: 60)
KIOSK_UNKNOWN_ALERT_COOLDOWN_S=60

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATION SETTINGS (RESEND API - OPTIONAL)
# ------------------------------------------------------------------------------
# [OPTIONAL] Resend API Key for sending alert emails (leave empty if not using email)
RESEND_API_KEY=

# [OPTIONAL] Sender email address configured in Resend
SENDER_EMAIL=onboarding@resend.dev

# [OPTIONAL] Default recipient email address for unknown/watchlist alerts
ALERT_TO=admin@example.com

# ------------------------------------------------------------------------------
# 6. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED FOR FRONTEND] Base API URL of backend server
REACT_APP_BACKEND_URL=http://localhost:8000
